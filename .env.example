# Server
APP_ENV=development
HTTP_PORT=8080

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=believers_palace
DB_SSLMODE=disable

# JWT
# Required in production. In development a weak default is used if empty.
JWT_SECRET=
JWT_ISSUER=believers_palace
# Access-token lifetime (short-lived). JWT_TTL is accepted as a fallback.
ACCESS_TOKEN_TTL=15m
# Refresh-token lifetime (long-lived, revocable).
REFRESH_TOKEN_TTL=720h
# Password-reset-token lifetime (single use).
RESET_TOKEN_TTL=1h

# File storage (certificate uploads)
STORAGE_DIR=./storage/certificates
MAX_UPLOAD_BYTES=10485760

# Image storage (logos, profile pictures, event/hall images). Uploaded via
# POST /api/media (multipart "file"); served publicly at GET /api/media/{key}.
MEDIA_DIR=./storage/media
MAX_IMAGE_BYTES=5242880

# Email delivery.
#   MAIL_PROVIDER=log   -> writes tokens to the server log (default; no setup)
#   MAIL_PROVIDER=smtp  -> sends real email (requires the SMTP_* vars below)
MAIL_PROVIDER=log
# Gmail example (use a 16-char App Password, NOT your normal password;
# requires 2-Step Verification enabled on the account):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   [email protected]
#   SMTP_PASSWORD=your-16-char-app-password
#   [email protected]
SMTP_HOST=believerspalace400@gmail.com
SMTP_PORT=587
SMTP_USERNAME==believers_palace
SMTP_PASSWORD=qrqhrfcnsjyltway
MAIL_FROM=believerspalace400@gmail.com

# Local testing only. When true, JWT auth is BYPASSED and a synthetic identity
# is injected (defaults to super_admin). Refused when APP_ENV=production.
# Override the identity per request with headers:
#   X-Debug-User-Id, X-Debug-Role, X-Debug-Church-Id
SKIP_JWT_VALIDATION=false

# CORS: comma-separated list of allowed origins. Defaults to "*" in development;
# REQUIRED in production (no wildcard default). Example:
#   CORS_ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com
CORS_ALLOWED_ORIGINS=

# Rate limiting (per-IP, requests per minute). Automatically disabled when
# SKIP_JWT_VALIDATION=true so local testing is not throttled.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_GENERAL_PER_MIN=120
RATE_LIMIT_AUTH_PER_MIN=10

# Logging: debug | info | warn | error (default info). JSON output in production.
LOG_LEVEL=info

# Public base URL used to build links in emails (no trailing slash).
PUBLIC_BASE_URL=http://localhost:8080
